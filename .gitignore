# ──────────────────────────────────────────────
#  Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ──────────────────────────────────────────────
#  실행 중 생성되는 로컬 DB
#  → 각자 로컬에서만 생성. 절대 공유(커밋)하지 말 것.
#    (바이너리라 병합이 불가능해 충돌의 주범이 됨)
# ──────────────────────────────────────────────
sessions.db
*.db
*.sqlite
*.sqlite3

# WAL 모드(db.py의 journal_mode = WAL)가 DB 파일 옆에 만드는 동반 파일.
# 이름이 sessions.db-wal 이라서 위의 *.db 패턴으로는 잡히지 않고,
# 서버를 켤 때마다 git status 에 untracked 로 떠서 커밋할 것을 가린다.
*.db-wal
*.db-shm
*.db-journal

# ──────────────────────────────────────────────
#  비밀정보 / API 키  ── ⚠️ 절대 커밋 금지 ⚠️
#  한 번이라도 push되면 기록에 영구히 남습니다.
# ──────────────────────────────────────────────
.env
*.key
*api*.txt
*API*.txt
전북대 llm api.txt
secret_config.py

# 대화/세션 내보내기 파일 (API 키가 포함될 수 있음)
*this-session*.txt

# ──────────────────────────────────────────────
#  에디터 / 개인 설정
# ──────────────────────────────────────────────
.claude/settings.local.json
.vscode/
.idea/
*.swp

# ──────────────────────────────────────────────
#  OS
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
