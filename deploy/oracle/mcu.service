[Unit]
Description=의대 예상문제 생성기 (Flask + waitress)
Documentation=https://github.com/cuteCrongCrong/MCU-summer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcu
Group=mcu
WorkingDirectory=/opt/mcu
EnvironmentFile=/etc/mcu/mcu.env
ExecStart=/opt/mcu/venv/bin/python /opt/mcu/serve.py

# 죽으면 자동 재시작 (LLM 호출 실패 등으로 프로세스가 내려가도 복구)
Restart=always
RestartSec=5

# 로그는 journald로 → sudo journalctl -u mcu -f
StandardOutput=journal
StandardError=journal
# 파이썬 출력 버퍼링을 끄지 않으면 로그가 늦게 보인다
Environment=PYTHONUNBUFFERED=1

# ── 보안 강화 ──
# 앱이 뚫려도 시스템 전체를 건드리지 못하게 권한을 좁힌다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# strict 모드에서 유일하게 쓰기 허용할 경로 = DB 디렉터리
ReadWritePaths=/var/lib/mcu

[Install]
WantedBy=multi-user.target
