[Unit]
Description=MCU 학습 플랫폼 (Flask + waitress)
Documentation=https://github.com/cuteCrongCrong/MCU-summer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcu
Group=mcu
WorkingDirectory=/opt/mcu
EnvironmentFile=/etc/mcu/mcu.env
ExecStart=/opt/mcu/venv/bin/python /opt/mcu/serve.py

# 죽으면 자동 재시작.
# e2-micro(RAM 1GB)에서는 큰 PDF를 처리하다 OOM Killer에게 죽을 수 있는데,
# 이 설정 덕분에 서비스 자체는 몇 초 만에 되살아난다. (그 요청 하나만 실패)
Restart=always
RestartSec=5

# 로그는 journald로 → sudo journalctl -u mcu -f
StandardOutput=journal
StandardError=journal
# 파이썬 출력 버퍼링을 끄지 않으면 로그가 늦게 보인다
Environment=PYTHONUNBUFFERED=1

# ── 보안 강화 ──
# 앱이 뚫려도 시스템 전체를 건드리지 못하게 권한을 좁힌다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# strict 모드에서 유일하게 쓰기 허용할 경로 = DB 디렉터리
ReadWritePaths=/var/lib/mcu

[Install]
WantedBy=multi-user.target
