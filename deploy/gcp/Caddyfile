# Caddy 설정 템플릿 — setup.sh 가 {{DOMAIN}}·{{APP_PORT}} 를 치환해
# /etc/caddy/Caddyfile 로 설치한다.
#
# Caddy는 이 도메인에 대해 Let's Encrypt 인증서를 자동으로 발급·갱신한다.
# (인증서 발급·갱신을 위해 80·443 포트가 외부에 열려 있어야 한다
#  → GCP는 VPC 방화벽 규칙에서 연다. 배포-GCP.md 참고)

{{DOMAIN}} {
	encode zstd gzip

	reverse_proxy 127.0.0.1:{{APP_PORT}} {
		# 문제 생성은 LLM을 여러 번 연달아 호출해 수 분이 걸린다.
		# 타임아웃을 넉넉히 두지 않으면 응답 전에 연결이 끊긴다.
		transport http {
			read_timeout 900s
			write_timeout 900s
			dial_timeout 10s
		}
	}

	# 업로드 용량 제한은 Caddy가 아니라 앱(MAX_UPLOAD_MB)에서 건다.
	# 여기서 막으면 Caddy의 HTML 오류가 나가서 프런트가 기대하는 JSON이 깨진다.

	log {
		output file /var/log/caddy/mcu.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
