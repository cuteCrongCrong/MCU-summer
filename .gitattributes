# 줄바꿈 통일 — OS가 섞인 팀에서 파일이 깨지지 않도록 명시한다.
* text=auto

# 셸 스크립트는 반드시 LF. CRLF로 저장되면 리눅스에서
#   "bad interpreter: /usr/bin/env bash^M" 오류로 실행이 안 된다.
*.sh text eol=lf

# 배치 파일은 반드시 CRLF. (cp949 인코딩은 Git이 건드리지 않음)
*.bat text eol=crlf

# 바이너리 — 줄바꿈 변환 금지
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pdf binary
*.png binary
*.jpg binary
